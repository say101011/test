    <string name="disclosure_fg_title">Location Access</string>
    <string name="disclosure_fg_desc">Near Alarm needs access to your device\'s location to display your position on the map and calculate distance to your destination.\n\nYour location data stays entirely on your device and is never transmitted to any external server.</string>
